{
    "version": "2025.11",
    "core-network-configuration": {
      "vpn-ecmp-support": true,
      "dns-support": true,
      "security-group-referencing-support": true,
      "inside-cidr-blocks": [
        "10.251.128.0/17"
      ],
      "asn-ranges": [
        "64512-64513"
      ],
      "edge-locations": [
        {
          "location": "us-east-1",
          "asn": 64512,
          "inside-cidr-blocks": [
            "10.251.128.0/24"
          ]
        },
        {
          "location": "us-west-2",
          "asn": 64513,
          "inside-cidr-blocks": [
            "10.251.129.0/24"
          ]
        }
      ]
    },
    "segments": [
      {
        "name": "NPTB1",
        "description": "Non-Prod Trust Boundary 1 - Lower Non-Trusted Workload",
        "require-attachment-acceptance": true
      },
      {
        "name": "NPTB2",
        "description": "Non-Prod Trust Boundary 2 - Lower Shared Services Workload",
        "require-attachment-acceptance": true
      },
      {
        "name": "NPTB3",
        "description": "Non-Prod Trust Boundary 3 - Lower Cardholder Data Workload",
        "require-attachment-acceptance": true
      },
      {
        "name": "NPSDWAN",
        "description": "Non Prod Environment SD-WAN tunnel-less Connect attachments",
        "require-attachment-acceptance": true
      },
      {
        "name": "NPCC",
        "description": "Non Prod Environment cross-cloud connectivity attachments",
        "require-attachment-acceptance": true
      },
      {
        "name": "PTB1",
        "description": "Prod Trust Boundary 1 - Prod Non-Trusted Workload",
        "require-attachment-acceptance": true
      },
      {
        "name": "PTB2",
        "description": "Prod Trust Boundary 2 - Prod Shared Services Workload",
        "require-attachment-acceptance": true
      },
      {
        "name": "PTB3",
        "description": "Prod Trust Boundary 3 - Prod Cardholder Data Workload",
        "require-attachment-acceptance": true
      },
      {
        "name": "PSDWAN",
        "description": "Prod Environment SD-WAN tunnel-less Connect attachments",
        "require-attachment-acceptance": true
      },
      {
        "name": "PCC",
        "description": "Prod Environment cross-cloud connectivity attachments",
        "require-attachment-acceptance": true
      },
      {
        "name": "ONPREM",
        "description": "To land DXG Attachment.  Inspection for ONPREM bound traffic is owned by the Edge Firewall at ONPREM.",
        "require-attachment-acceptance": true
      }
    ],
    "network-function-groups": [
      {
        "name": "NPEWNFG",
        "description": "Non-Prod East-West Inspection Network Function Group",
        "require-attachment-acceptance": false
      },
      {
        "name": "PEWNFG",
        "description": "Production East-West Inspection Network Function Group - also owns the sanctioned non-prod to prod shared services path",
        "require-attachment-acceptance": false
      },
      {
        "name": "NPNSNFG",
        "description": "Non-Prod North-South Egress Inspection Network Function Group",
        "require-attachment-acceptance": false
      },
      {
        "name": "PNSNFG",
        "description": "Production North-South Egress Inspection Network Function Group",
        "require-attachment-acceptance": false
      }
    ],
    "segment-actions": [
      {
        "action": "share",
        "mode": "attachment-route",
        "segment": "ONPREM",
        "share-with": [
          "NPTB1",
          "NPTB2",
          "NPTB3",
          "NPSDWAN",
          "PTB1",
          "PTB2",
          "PTB3",
          "PSDWAN"
        ]
      },
      {
        "action": "send-via",
        "segment": "NPTB1",
        "mode": "dual-hop",
        "when-sent-to": {
          "segments": [
            "NPTB2",
            "NPSDWAN",
            "NPCC"
          ]
        },
        "via": {
          "network-function-groups": [
            "NPEWNFG"
          ]
        }
      },
      {
        "action": "send-via",
        "segment": "NPTB2",
        "mode": "dual-hop",
        "when-sent-to": {
          "segments": [
            "NPTB3",
            "NPSDWAN",
            "NPCC"
          ]
        },
        "via": {
          "network-function-groups": [
            "NPEWNFG"
          ]
        }
      },
      {
        "action": "send-via",
        "segment": "PTB2",
        "mode": "dual-hop",
        "when-sent-to": {
          "segments": [
            "NPTB1",
            "NPTB2",
            "NPSDWAN",
            "NPCC",
            "PTB1",
            "PTB3",
            "PSDWAN",
            "PCC"
          ]
        },
        "via": {
          "network-function-groups": [
            "PEWNFG"
          ]
        }
      },
      {
        "action": "send-via",
        "segment": "PTB1",
        "mode": "dual-hop",
        "when-sent-to": {
          "segments": [
            "PSDWAN",
            "PCC"
          ]
        },
        "via": {
          "network-function-groups": [
            "PEWNFG"
          ]
        }
      },
      {
        "action": "send-to",
        "segment": "NPTB1",
        "via": {
          "network-function-groups": [
            "NPNSNFG"
          ]
        },
        "when-sent-to": {
          "segments": "NPTB1"
        }
      },
      {
        "action": "send-to",
        "segment": "NPTB2",
        "via": {
          "network-function-groups": [
            "NPNSNFG"
          ]
        },
        "when-sent-to": {
          "segments": "NPTB2"
        }
      },
      {
        "action": "send-to",
        "segment": "PTB1",
        "via": {
          "network-function-groups": [
            "PNSNFG"
          ]
        },
        "when-sent-to": {
          "segments": "PTB1"
        }
      },
      {
        "action": "send-to",
        "segment": "PTB2",
        "via": {
          "network-function-groups": [
            "PNSNFG"
          ]
        },
        "when-sent-to": {
          "segments": "PTB2"
        }
      }
    ],
    "attachment-policies": [
      {
        "rule-number": 1,
        "condition-logic": "and",
        "conditions": [
